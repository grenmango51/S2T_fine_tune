# Local secrets (an example with empty values is safe to share)
.env
.env.*
!.env.example
*.token

# Local datasets and training artifacts; root-anchored to keep source packages
/corpus/
/data/
/recordings/
/models/
/runs/
/checkpoints/
/output/
/wandb/
/.local/

# Generated evaluation outputs; publish only curated aggregate documentation
/reports/*
!/reports/README.md

# Python environments, caches, and build products
.venv*/
venv/
env/
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.cache/
*.egg-info/
/build/
/dist/
*.log

# Large binary assets
*.wav
*.mp3
*.flac
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.safetensors
*.bin
*.pt
*.pth
*.sqlite*

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
